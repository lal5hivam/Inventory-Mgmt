# ========================================
# RAILWAY.APP FRONTEND DEPLOYMENT
# Environment Variables Configuration
# ========================================

# Backend API URL (REQUIRED)
# Replace with your actual Render backend URL after deployment
REACT_APP_API_BASE_URL=https://inventory-backend.onrender.com


# ========================================
# HOW TO SET ON RAILWAY:
# ========================================
# 1. Go to your Railway frontend service
# 2. Click "Variables" tab
# 3. Click "New Variable"
# 4. Add: REACT_APP_API_BASE_URL
# 5. Value: Your Render backend URL
# 6. Save and redeploy
