# ========================================
# RENDER.COM BACKEND DEPLOYMENT
# Environment Variables Configuration
# ========================================

# Spring Profile (REQUIRED)
SPRING_PROFILES_ACTIVE=prod

# Railway MySQL Database Connection (REQUIRED)
# Get these from Railway Dashboard → inventory-db → Connect tab
DB_URL=jdbc:mysql://RAILWAY_HOST:RAILWAY_PORT/railway?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=RAILWAY_DB_PASSWORD

# JWT Secret (REQUIRED - Generate new one for production)
# Generate with: openssl rand -base64 32
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_MIN_256_BITS

# CORS - Frontend URL (REQUIRED)
# Replace with your actual Railway frontend URL
CORS_ALLOWED_ORIGINS=https://inventory-mgmt-production.up.railway.app

# Optional: Override default port (Render uses PORT automatically)
# SERVER_PORT=8080

# Optional: JWT Token Expiration (default: 24 hours)
# JWT_EXPIRATION_MS=86400000


# ========================================
# HOW TO DEPLOY ON RENDER.COM (DOCKER):
# ========================================
# 1. Go to: https://render.com
# 2. Click "New +" → "Web Service"
# 3. Connect GitHub: lal5hivam/Inventory-Mgmt
# 4. Configure:
#    - Name: inventory-backend
#    - Root Directory: backend
#    - Environment: Docker
#    - Instance Type: Free
# 5. Click "Environment" tab
# 6. Add each variable above (one per line)
# 7. Click "Create Web Service"
# 8. Wait for build (~5-10 minutes)
