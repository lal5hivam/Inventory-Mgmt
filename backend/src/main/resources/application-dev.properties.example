# Development Environment Configuration - EXAMPLE FILE
# Copy this file to application-dev.properties and update with your local settings
# DO NOT commit application-dev.properties with real credentials

spring.application.name=InventoryMgtSystem
server.port=5050

# CORS Configuration - Add your frontend URL
cors.allowed.origins=http://localhost:3000

# MYSQL CONNECTION - Development
spring.datasource.url=jdbc:mysql://localhost:3306/inventory_db
spring.datasource.username=root
spring.datasource.password=YOUR_LOCAL_DB_PASSWORD_HERE
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# File Upload Configuration
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

# JWT Configuration
# Generate a strong secret with: openssl rand -base64 32
jwt.secret=YOUR_JWT_SECRET_HERE_MIN_256_BITS
jwt.expiration.ms=86400000
